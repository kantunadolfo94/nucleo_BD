{
  "name": "sneakshop",
  "version": "1.0.0",
  "description": "SneakShop — Tienda de calzado deportivo, casual y de vestir. Node.js + TypeScript + Express + Turso (libSQL).",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/db/init.ts",
    "demo:productos": "tsx src/modules/productos/demo.ts"
  },
  "keywords": [
    "sneakshop",
    "express",
    "typescript",
    "turso",
    "libsql"
  ],
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
